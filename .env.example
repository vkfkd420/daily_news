VITE_APP_NAME=Daily News
VITE_AUTO_SYNC_ON_LOAD=true

# === ChatGPT Plus (추가 결제 없음, 추천) ===
BRIEFING_SYNC_MODE=none
BRIEFING_AUTO_SYNC=false
VITE_AUTO_SYNC_ON_LOAD=false

# === 이 프로젝트 repo에 push (Plus: 붙여넣기 후 briefing:push-github) ===
# GITHUB_TOKEN=github_pat_...
# GITHUB_OWNER=내아이디          # git remote 있으면 생략 가능
# GITHUB_REPO=daily_news         # 기본 = package.json name
# GITHUB_BRANCH=main

# === 앱이 같은 repo raw에서 읽기 (public) ===
# BRIEFING_SYNC_URL=https://raw.githubusercontent.com/내아이디/daily_news/main/data/briefings/latest.json
# BRIEFING_SYNC_MODE=url
# VITE_AUTO_SYNC_ON_LOAD=true

# === OpenAI API (Plus와 별도 과금, 완전 자동) ===
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# BRIEFING_SYNC_MODE=openai
# BRIEFING_AUTO_SYNC=true
# BRIEFING_SYNC_HOUR=8

# 또는 JSON URL
# BRIEFING_SYNC_URL=https://example.com/briefing.json
# BRIEFING_SYNC_MODE=url
